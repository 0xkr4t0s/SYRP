{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Syrp work package (work/packages/<id>.toml)",
  "description": "Parsed and enforced by `cargo syrp wp validate`; this schema documents the same rules for editors and agents.",
  "type": "object",
  "required": ["id", "title", "spec", "acceptance"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^WP-[0-9]+\\.[0-9]+-[0-9]{2}$" },
    "title": { "type": "string" },
    "crate": { "type": "string", "description": "Crate directory this WP owns, e.g. crates/foundation/rt." },
    "paths": { "type": "array", "items": { "type": "string" }, "description": "Extra owned paths; a trailing / means a directory." },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "contracts": { "type": "array", "items": { "type": "string" } },
    "ledger_rows": { "type": "array", "items": { "type": "string" } },
    "spec": { "type": "string" },
    "scenarios": { "type": "array", "items": { "type": "string" } },
    "tolerance": { "type": "string" },
    "risk": {
      "type": "array",
      "items": { "enum": ["public-api", "unsafe", "ffi", "plugin-wrapper", "licensing", "ci-infra", "contract-change", "supply-chain", "rt-safety"] }
    },
    "acceptance": { "type": "string" },
    "platforms": { "type": "array", "items": { "enum": ["linux", "macos", "windows", "ios", "android", "web"] } },
    "role": { "enum": ["implementer", "spec-room", "pr-manager", "oracle", "human"], "default": "implementer" },
    "status": { "enum": ["planned", "done"], "default": "planned" },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_hours": { "type": "integer", "minimum": 1 },
        "max_review_rounds": { "type": "integer", "minimum": 1 },
        "max_restarts": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
